#!/usr/bin/env bash
# Wrapper around the real NotebookLM CLI. Three jobs, all structural — they hold
# regardless of what the agent remembers to do.
#
# 1) SERIALIZE every call.
# There is a single shared browser profile at ~/.notebooklm, and Chrome/Playwright
# cannot drive one profile from two processes at once (SingletonLock). So when the
# dispatcher runs several paper subagents in parallel and they each call
# `notebooklm ask`, the sessions collide — the documented failure mode of
# summarized / stub / duplicated sections. flock makes concurrent invocations QUEUE
# instead of conflict: the lock is held for the whole command, so a 60-120s `ask`
# blocks other asks until it finishes, while the rest of each paper's pipeline
# (figure/table extraction, Notion upload) still runs in parallel.
#
# This is the structural reason the user never has to serialize requests by hand.
# Lock next to the ~/.notebooklm profile it guards (same container user -> same
# HOME -> same lock, still serialized); avoids a /tmp file owned by another user.
#
# 2) Give every call a CLEAN CONTEXT.
# flock serializes single commands, not a subagent's sequence of commands, and every
# call shares one context file (profiles/default/context.json: the notebook `use`
# picked, the conversation the last `ask` left). `ask -n X` resumes the cached
# conversation whenever X is the cached notebook, and another subagent's ask may
# have replaced it with a conversation of ITS notebook — the ask is then answered
# from the other paper's sources. A command with no -n acts on whichever notebook
# another subagent selected last (a source added to an older paper's notebook). So
# the context is deleted under the lock before every call: a command without -n now
# fails loudly ("No notebook specified. Use 'notebooklm use <id>' ..." — that `use`
# hint is refused here, pass --notebook instead), and `ask` resumes the named
# notebook's own latest conversation from the server. `use` is refused, since it
# only fills the file the next call deletes.
#
# Also refused: a second cookie jar (root -p/--profile/--storage, NOTEBOOKLM_PROFILE,
# NOTEBOOKLM_HOME, an inline NOTEBOOKLM_AUTH_JSON, every `profile` command but
# `list`). It would give a subagent a private context, but it needs a copy of
# storage_state.json, and Google rotates the two copies' cookies independently:
# whichever rotated last stays valid and the other is signed out. The shared jar
# went first, and every later resume failed on auth. So never copy
# storage_state.json; pass --notebook <id> to every command instead. A config.json
# whose default_profile is not "default" (a `profile switch` on the host) is refused
# too: every call would run in another jar, with a context this wrapper never clears.
# So is the android backend (root --backend android, NOTEBOOKLM_BACKEND=android): it
# signs in with master_token.json, a full-account credential minted into OAuth
# bearers, not with the shared storage_state.json.
#
# 3) Make `create` IDEMPOTENT and SELF-RECORDING.
# Registering a new notebook in notebooks.json was a prose rule, and a missed
# registration is expensive: the next question about that paper finds nothing,
# creates ANOTHER notebook, re-uploads the PDF and waits for NotebookLM to index it
# before it can even ask — minutes of latency, a duplicate notebook, and NotebookLM
# usage spent. Routing `create` through the registry means an existing
# notebook is reused and a new one records itself, so the agent cannot forget.
set -uo pipefail

REAL=${NOTEBOOKLM_REAL_BIN:-/usr/local/lib/notebooklm-real}
REGISTRY_PY=${NOTEBOOK_REGISTRY_PY:-/workspace/group/research-papers/notebook_registry.py}
NLM_HOME=${NOTEBOOKLM_HOME:-${HOME:-/tmp}/.notebooklm}

refuse() {
  echo "notebooklm wrapper: $1; ${2:-pass --notebook <id> to every command}" >&2
  exit 2
}

jar="a second cookie jar needs a copy of storage_state.json, and the two copies\
 rotate apart until one is signed out"

# Refuse before taking the lock, so a refused call never waits in the queue. The
# CLI ignores an empty NOTEBOOKLM_PROFILE/NOTEBOOKLM_HOME and fails on an empty
# NOTEBOOKLM_AUTH_JSON by itself, so only a non-empty one is refused.
[ -n "${NOTEBOOKLM_PROFILE:-}" ] && refuse "NOTEBOOKLM_PROFILE is refused: $jar"
[ -n "${NOTEBOOKLM_HOME:-}" ] && refuse "NOTEBOOKLM_HOME is refused: $jar"
[ -n "${NOTEBOOKLM_AUTH_JSON:-}" ] && refuse "NOTEBOOKLM_AUTH_JSON is refused: $jar"

# The CLI fails on an empty NOTEBOOKLM_BACKEND by itself, like on an empty
# NOTEBOOKLM_AUTH_JSON, so only a non-empty value other than web is refused.
android="it signs in with master_token.json, a second credential beside the shared\
 storage_state.json"
web_only="drop it, the web backend is the default"
backend=${NOTEBOOKLM_BACKEND:-web}
[ "$backend" = "web" ] ||
  refuse "NOTEBOOKLM_BACKEND=$backend is refused: $android" "$web_only"

# Root options are the tokens before the subcommand. -p/--profile, --storage and
# --backend take a value. The first two are refused outright; --backend's value is
# the next token whatever it looks like (as the CLI reads it), so `--backend web use`
# is a `use`. The first other token not starting with '-' is the subcommand. The
# root's only short options are -p and -v, so a short cluster holding a 'p' (-p,
# -px, -vp) sets a profile. Options after the subcommand are its own (`share add -p`
# is --permission) and are never checked.
sub=""
n=0
value_of=""
for arg in "$@"; do
  n=$((n + 1))
  if [ -n "$value_of" ]; then
    [ "$arg" = "web" ] || refuse "$value_of $arg is refused: $android" "$web_only"
    value_of=""
    continue
  fi
  case "$arg" in
    --) continue ;;
    --profile | --profile=* | --storage | --storage=*) refuse "$arg is refused: $jar" ;;
    --backend) value_of=$arg ;;
    --backend=web) continue ;;
    --backend=*) refuse "$arg is refused: $android" "$web_only" ;;
    --*) continue ;;
    -*p*) refuse "-p (--profile) is refused: $jar" ;;
    -*) continue ;;
    *) sub=$arg; break ;;
  esac
done
[ "$sub" = "use" ] && refuse "'use' is refused: the context it sets is shared by every\
 parallel subagent and is cleared before each call"

# `profile` takes no options of its own, so its first non-option token is the
# action. Only `list` reads; create/switch/rename/delete make or move to another jar.
if [ "$sub" = "profile" ]; then
  action=""
  for arg in "${@:n+1}"; do
    case "$arg" in
      -*) continue ;;
      *) action=$arg; break ;;
    esac
  done
  [ "$action" = "list" ] ||
    refuse "'profile${action:+ $action}' is refused, only 'profile list' runs: $jar"
fi

exec 9>"${HOME:-/tmp}/notebooklm.lock"
flock 9

# config.json is shared with the host, where `notebooklm profile switch` is not
# wrapped, so it is read under the lock: a switch made while this call queued still
# counts. Read the way the CLI reads it — a non-empty string default_profile wins,
# anything else (no file, bad JSON, no key, "") means "default".
cfg=$NLM_HOME/config.json
if [ -f "$cfg" ]; then
  default_profile=$(python3 -I -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit()
value = data.get("default_profile") if isinstance(data, dict) else None
print(value if isinstance(value, str) else "")
' "$cfg" 2>/dev/null)
  if [ -n "$default_profile" ] && [ "$default_profile" != "default" ]; then
    refuse "$cfg sets default_profile '$default_profile': every call would run in\
 another cookie jar, with a context this wrapper never clears" \
      "run 'notebooklm profile switch default' on the host"
  fi
fi

rm -f "$NLM_HOME/profiles/default/context.json" "$NLM_HOME/context.json"

orig=("$@")
title="" json=""
if [ "$sub" = "create" ] && [ -f "$REGISTRY_PY" ]; then
  # `create`'s own options (-u/--use, --json) take no value, so its first
  # non-option token is the title.
  for arg in "${@:n+1}"; do
    case "$arg" in
      --json) json=--json ;;
      -*) ;;
      *) [ -z "$title" ] && title=$arg ;;
    esac
  done
fi
if [ -n "$title" ]; then
  # The registry prints the same {"notebook": {...}} shape the real CLI does, so a
  # caller parsing `create --json` needs no change. On any failure fall through to
  # the real CLI, with the original argv, rather than blocking a create. --use/-u is
  # accepted and ignored here (and harmless in the real create's fall-through):
  # the context it would set is deleted before the next call anyway, so the caller
  # passes --notebook <id> from the printed id.
  if out=$(NOTEBOOKLM_REAL=$REAL python3 "$REGISTRY_PY" --get-or-create \
             --title "$title" $json 2>/dev/null) && [ -n "$out" ]; then
    printf '%s\n' "$out"
    exit 0
  fi
fi

exec "$REAL" "${orig[@]}"
